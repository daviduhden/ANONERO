root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = ktlint_official
# Compose UI functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# NetworkType_* is persisted by kotlinx.serialization in nodes_store and used by the
# backup format; the other *_ names intentionally mirror wallet2 enum spellings.
ktlint_standard_enum-entry-name-case = disabled
# The codebase uses a leading underscore for private state, not only for observable
# backing properties with a public counterpart. Enforcing the rule would force a
# repository-wide rename without fixing a defect.
ktlint_standard_backing-property-naming = disabled
max_line_length = 140

[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = false

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[**/NavGraph.kt]
# Deliberate legacy stub, documented in docs/; remove in a dedicated cleanup.
ktlint_standard_no-empty-file = disabled
ktlint_standard_no-consecutive-comments = disabled
