ARG BASE=debian@sha256:6ebd97fa83deb272194a2cf015b3d26a4d538e9ad3a7a79d544c8af5b0a01443
FROM ${BASE} AS base

# Reproducible-builds knobs for every stage below.
ARG SOURCE_DATE_EPOCH=1704067200
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    TZ=UTC \
    LC_ALL=C.UTF-8 \
    ZERO_AR_DATE=1
ENV WORK=/opt/build PREFIX=/opt/build/prefix OUT=/opt/out SRC=/opt/build/src MONERO=/src

# Freeze the apt toolchain to a Debian snapshot (matches the base image date), else
# gcc/binutils drift over time. Valid-Until off: snapshot Release files are stale.
ARG SNAPSHOT=20260824T000000Z
RUN set -x \
 && printf 'deb http://snapshot.debian.org/archive/debian/%s/ bookworm main\ndeb http://snapshot.debian.org/archive/debian-security/%s/ bookworm-security main\ndeb http://snapshot.debian.org/archive/debian/%s/ bookworm-updates main\n' \
      "$SNAPSHOT" "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/* \
 && printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "8";\n' \
      > /etc/apt/apt.conf.d/10repro

RUN set -x \
 && for attempt in 1 2 3 4 5; do \
      if apt-get update && apt-get install -y --no-install-recommends \
        build-essential automake libtool pkg-config curl wget file unzip git \
        ca-certificates python3 python-is-python3 flex bison; then \
        break; \
      fi; \
      if [ "$attempt" = 5 ]; then exit 1; fi; \
      echo "apt attempt $attempt failed; retrying" >&2; \
      sleep $((attempt * 15)); \
    done \
 && rm -rf /var/lib/apt/lists/*

# Downloads every dependency once; all three target builds reuse this layer.
FROM base AS sources
WORKDIR /external-libs
COPY build.sh /external-libs/
RUN chmod +x /external-libs/build.sh
RUN ./build.sh fetch

FROM sources
ARG TARGET
ARG NPROC=4
ENV TARGET=${TARGET} NPROC=${NPROC}

RUN ./build.sh toolchain

# One RUN per dependency, so a late failure doesn't rebuild the earlier ones. Every
# target builds its own, so the artifacts carry no dependency on the host distro.
RUN ./build.sh iconv
RUN ./build.sh boost
RUN ./build.sh zlib
RUN ./build.sh openssl
RUN ./build.sh zmq
RUN ./build.sh sodium
RUN ./build.sh expat
RUN ./build.sh unbound
RUN ./build.sh polyseed
RUN ./build.sh utf8proc

# Monero source last, so editing it leaves every layer above cached.
# external-libs/Makefile applies the pinned ANONERO API patch series on the host
# first; the tree copied here is official Monero v0.18.5.4 plus those patches.
COPY monero/ /src/
RUN grep -q "struct CoinsInfo" /src/src/wallet/api/wallet2_api.h \
 && grep -q "viewOnlyBalance" /src/src/wallet/api/wallet2_api.h \
 || { echo "Monero API patches are missing; run 'make patches' first" >&2; exit 1; }
RUN ./build.sh monero
RUN ./build.sh collect

# jni.h, for building libanonero.so against this image's glibc rather than the host's.
# Compile-time only -- JNI calls go through the JNIEnv table, so the .so links no JVM
# library and picks up no new dependency. Last, so it can't invalidate the layers above.
RUN if [ "$TARGET" = linux ]; then set -x \
 && for i in 1 2 3 4 5; do apt-get update && break; [ "$i" = 5 ] && exit 1; echo "apt retry $i"; sleep 5; done \
 && apt-get install -y --no-install-recommends default-jdk-headless \
 && rm -rf /var/lib/apt/lists/*; fi
