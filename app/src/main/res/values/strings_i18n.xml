    <string name="lws_title">Light Wallet Server</string>
    <string name="use_lws">Use LWS</string>
    <string name="lws_supporting">Offloads view-key scanning to a Monero light-wallet server. Only the public address and private view key are sent; the spend key never leaves this device.</string>
    <string name="lws_host">LWS host</string>
    <string name="lws_port">Port</string>
    <string name="lws_privacy_warning">Privacy: the LWS operator can see your address, every incoming amount, and approximately when it arrived. It cannot spend. Tor hides your IP from the operator but does not remove the trust you place in the server. Prefer a server you operate yourself.</string>
    <string name="lws_tor_enabled">Built-in Tor is enabled. LWS traffic will use it.</string>
    <string name="lws_tor_disabled">Built-in Tor is disabled. LWS cannot be enabled until Tor is on.</string>
    <string name="lws_restart_warning">Applying LWS requires an app restart. Normal node settings are ignored while LWS is enabled. Light-wallet mode may not support every server (notably subaddress-heavy wallets) and is experimental in ANONERO.</string>
    <string name="lws_saved_restart">Saved. Restart ANONERO to use this configuration.</string>
    <string name="lws_requires_tor">LWS requires Tor. Enable built-in Tor in Proxy settings first.</string>
    <string name="lws_error_host_empty">Host cannot be empty</string>
    <string name="lws_error_host_too_long">Host is too long</string>
    <string name="lws_error_host_format">Enter only the host name, without scheme, path or port</string>
    <string name="lws_error_host_invalid">Invalid host name</string>
    <string name="lws_error_port_range">Port must be between 1 and 65535</string>

    <string name="decoy_duress_title">Decoy &amp; Duress</string>
    <string name="decoy_not_available">This setting is not available for the current wallet.</string>
    <string name="decoy_remove_title">Remove decoy wallet?</string>
    <string name="decoy_remove_warning">This deletes the decoy wallet file, its Keystore key, and its duress PIN. Funds in the decoy are lost unless you have its seed. The legitimate wallet is not touched.</string>
    <string name="remove">Remove</string>
    <string name="decoy_intro">The decoy is a completely separate wallet file with its own Keystore-wrapped secret, PIN, passphrase and history. The normal PIN opens this wallet; the duress PIN opens the decoy.</string>
    <string name="decoy_limits">Limits: this is separation, not plausible deniability. Forensic access to an unlocked device can reveal that two wallets exist. Do not rely on the decoy against device seizure.</string>
    <string name="creating_decoy_wallet">Creating decoy wallet…</string>
